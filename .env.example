# URL base do painel admin (projeto separado "adom-admin"), que expõe
# /api/products e /api/categories. Em produção, aponte para a URL do
# admin publicado no Vercel.
VITE_ADMIN_API_URL=http://localhost:3000

# Quando "true", usa produtos fictícios (src/data/demo/products.ts) em vez de
# buscar do admin — útil pra testar layout/animações sem tocar nos produtos
# reais, que vão direto para produção. Deixe em "false" (ou remova) fora do
# seu .env.local — nunca deve ir para produção.
VITE_USE_MOCK_CATALOG=false
